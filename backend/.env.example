# WearWise 后端配置（复制为 .env 并填入真实值；.env 已 gitignore，不会进仓库）
# 火山方舟（豆包 / 即梦）API Key：验收前提供即可，开发期可留空走 mock
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型：填「推理接入点 ID」（ep- 开头），不是模型名；在方舟控制台「在线推理」创建
# 文字/识别可用同一个多模态接入点（如 Doubao-Seed-2.1-lite）
VISION_MODEL=
TEXT_MODEL=
# 图像生成：Doubao-Seedream-5.0-pro（需 1920x1920 以上尺寸）
IMAGE_MODEL=

# 无 Key 或调试时强制 mock（true=不调用真实模型）
MOCK_LLM=true

# 模型调用超时（秒）
REQUEST_TIMEOUT=60

# 上传文件上限（MB）
MAX_UPLOAD_MB=20
